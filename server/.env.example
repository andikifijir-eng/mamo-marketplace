# ===== MAMO Server Environment =====
# PostgreSQL connection (Neon/Supabase untuk production)
DATABASE_URL="postgresql://USER:PASS@HOST:5432/mamo?schema=public"

# JWT
JWT_SECRET="generate-random-string-min-32-chars"
JWT_EXPIRES_IN="7d"

# Server
PORT=4000
CORS_ORIGIN="*"

# Upload
UPLOAD_DIR="uploads"
MAX_UPLOAD_MB=5
